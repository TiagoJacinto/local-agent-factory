# SSSF environment. Copy to .env at the target repo root and fill in.
#
# The current roster uses Pi's OpenCode Zen model:
#   opencode/mimo-v2.5-free
#
# Authenticate it once in Pi. Start `pi`, then run:
#   /login opencode
#
# Pi stores the OAuth credential. No provider API key is needed in this file.
# `agents.validate()` also requires the model to appear in `pi --list-models`,
# so complete the login before running an ADW.

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name
