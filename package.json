{
  "name": "local-agent-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "vitest run",
    "test:hvut": "bunx vitest run --project hvut features/execute-workflow.hvut.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src features",
    "lint:fix": "oxlint src features --fix",
    "start": "bun run src/cli.ts",
    "dev": "bun --watch run src/cli.ts"
  },
  "bin": {
    "local-agent-factory": "./src/cli.ts"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@types/bun": "^1.3.4",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
