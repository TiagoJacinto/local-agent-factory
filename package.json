{
  "name": "local-agent-factory",
  "version": "0.5.6",
  "private": false,
  "bin": {
    "laf": "./src/entrypoints/cli.ts"
  },
  "files": [
    "src",
    "src/skills/sssf/apps/visualizer/dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "bun install --frozen-lockfile",
    "setup": "bun run bootstrap",
    "update": "bun run bootstrap",
    "server": "bun run start",
    "console": "bun run start",
    "cibuild": "bun run lint && bun run lint:boundaries && bun run typecheck && bun run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:hvut": "bunx vitest run --project hvut tests/acceptance/unit/*.hvut.ts",
    "typecheck": "bun run typecheck:factory && bun run typecheck:app",
    "lint": "oxlint src tests",
    "lint:boundaries": "depcruise src tests",
    "lint:staged": "oxlint",
    "lint:fix": "oxlint src tests --fix",
    "build:visualizer": "cd src/skills/sssf/apps/visualizer && bun install --frozen-lockfile && bun run build && rm -rf node_modules",
    "build:package": "bun run build:visualizer",
    "prepublishOnly": "bun run build:package",
    "start": "bun run src/entrypoints/cli.ts greet",
    "dev": "bun --watch run src/entrypoints/cli.ts greet",
    "typecheck:factory": "bun run typecheck.ts",
    "typecheck:app": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@types/bun": "^1.3.4",
    "dependency-cruiser": "^18.2.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
